<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record model="ir.ui.view" id="fs_storage_form_view">
        <field name="model">fs.storage</field>
        <field name="inherit_id" ref="fs_attachment.fs_storage_form_view" />
        <field name="arch" type="xml">

            <!-- Hide complex options JSON when S3 -->
            <field name="options" position="attributes">
                <attribute name="invisible">protocol == 's3'</attribute>
            </field>

            <!-- Hide directory_path when S3 (s3_bucket replaces it) -->
            <field name="directory_path" position="attributes">
                <attribute name="invisible">protocol == 's3'</attribute>
            </field>

            <!-- Hide advanced/irrelevant fields when S3 -->
            <field name="eval_options_from_env" position="attributes">
                <attribute name="invisible">protocol == 's3'</attribute>
            </field>
            <field name="model_ids" position="attributes">
                <attribute name="invisible">protocol == 's3'</attribute>
            </field>
            <field name="field_ids" position="attributes">
                <attribute name="invisible">protocol == 's3'</attribute>
            </field>
            <field name="check_connection_method" position="attributes">
                <attribute name="invisible">protocol == 's3'</attribute>
            </field>
            <field name="is_cacheable" position="attributes">
                <attribute name="invisible">protocol == 's3'</attribute>
            </field>
            <field name="force_db_for_default_attachment_rules" position="attributes">
                <attribute name="invisible">protocol == 's3'</attribute>
            </field>
            <field name="use_x_sendfile_to_serve_internal_url" position="attributes">
                <attribute name="invisible">protocol == 's3'</attribute>
            </field>
            <field name="s3_uses_signed_url_for_x_sendfile" position="attributes">
                <attribute name="invisible">1</attribute>
            </field>
            <field name="s3_signed_url_expiration" position="attributes">
                <attribute name="invisible">1</attribute>
            </field>

            <!-- Hide notebook tabs (advanced) for S3 -->
            <xpath expr="//notebook" position="attributes">
                <attribute name="invisible">protocol == 's3'</attribute>
            </xpath>

            <!-- Show S3-specific simple fields after options -->
            <field name="options" position="after">
                <field
                    name="s3_endpoint_url"
                    string="Endpoint URL"
                    invisible="protocol != 's3'"
                    placeholder="https://s3.amazonaws.com"
                />
                <field
                    name="s3_access_key_id"
                    string="Access Key ID"
                    invisible="protocol != 's3'"
                />
                <field
                    name="s3_secret_access_key"
                    string="Secret Access Key"
                    invisible="protocol != 's3'"
                    password="True"
                />
                <field
                    name="s3_region"
                    string="Region"
                    invisible="protocol != 's3'"
                    placeholder="us-east-1"
                />
                <field
                    name="s3_bucket"
                    string="Bucket"
                    invisible="protocol != 's3'"
                    placeholder="my-s3-bucket"
                />
            </field>

        </field>
    </record>
</odoo>
