<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="model">res.config.settings</field>
        <field
            name="inherit_id"
            ref="base_setup.res_config_settings_view_form"
        />
        <field name="arch" type="xml">
            <xpath
                expr="//app[@name='general_settings']/div[@id='about']"
                position="before"
            >
                <block
                    title="Attachment Object Storage"
                    name="attachment_storage_block"
                >
                    <setting
                        string="Migrate Attachments to S3"
                        help="Migrate all existing attachments from the database and filesystem to the configured S3 object storage. This action cannot be undone."
                    >
                        <button
                            type="object"
                            name="action_force_migrate_to_s3"
                            string="Force Migrate to S3"
                            class="btn btn-primary"
                            confirm="This will migrate ALL attachments to S3. This operation may take a while for large volumes. Continue?"
                        />
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
